<UserControl x:Class="BloodBankAccounting.Views.ProductCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BloodBankAccounting.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter             x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <ScrollViewer x:Name="OuterScroll"
              VerticalScrollBarVisibility="Disabled"
              HorizontalScrollBarVisibility="Auto"
              PreviewMouseWheel="OuterScroll_PreviewMouseWheel">
        <Grid Margin="20" MinWidth="920" Width="1092">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="600"/>
                <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <DockPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Text="كتالوج الأصناف"
                               FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,14"/>

                    <TextBlock DockPanel.Dock="Top"
                               Text="⏳ جارٍ التحميل..."
                               FontSize="13" Foreground="#C0392B"
                               Margin="0,0,0,8"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <DataGrid Style="{StaticResource MainDataGrid}"
                              ItemsSource="{Binding Items}"
                              IsReadOnly="True"
                              RowHeight="36"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                        <Setter Property="Background" Value="#F8F8F8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="اسم الصنف"
                                               Binding="{Binding Name}"
                                               Width="*"
                                               MinWidth="160"/>

                            <DataGridTextColumn Header="سعر البيع (ج.م)"
                                                 Binding="{Binding DefaultSalePrice, StringFormat='{}{0:N2}'}"
                                                 Width="120" MinWidth="120"/>

                            <DataGridTemplateColumn Header="حد الطلب" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding ReorderLevel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReorderLevel}" Value="{x:Null}">
                                                            <Setter Property="Text"       Value="—"/>
                                                            <Setter Property="Foreground" Value="#9AA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الحالة" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,3"
                                                HorizontalAlignment="Center"
                                                Margin="2,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D5F5E3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#F0F0F0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"       Value="✓ فعّال"/>
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text"       Value="معطّل"/>
                                                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="" Width="Auto" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">

                                            <Button Content="✏️ تعديل"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.EditItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>

                                            <Button Command="{Binding DataContext.ToggleActiveCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content"    Value="🚫 تعطيل"/>
                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Content"    Value="✅ تفعيل"/>
                                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>

                    <!-- الأزرار ثابتة في الأسفل دايماً -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                        Content="💾  حفظ"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Height="44" FontSize="13"/>
                            <Button Grid.Column="2"
                        Content="➕  جديد"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding NewItemCommand}"
                        Height="44" FontSize="13"/>
                        </Grid>

                        <Border Margin="0,14,0,0"
                    Background="#EBF5FB" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#1A5276">
                    <Run Text="✏️ وضع التعديل — "/>
                    <Run Text="{Binding Name}"/>
                    <Run Text=" — اضغط 'جديد' للرجوع لوضع الإضافة."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- الحقول قابلة للـ Scroll -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="{Binding FormTitle}"
                           FontWeight="Bold" FontSize="14"
                           Foreground="#1A2744"
                           Margin="0,0,0,20"/>

                            <TextBlock Text="اسم الصنف *" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,0,0,14"/>

                            <TextBlock Text="سعر البيع الافتراضي (ج.م) *" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding DefaultSalePrice, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"
                         Margin="0,0,0,14"/>

                            <TextBlock Text="الحد الأدنى لإعادة الطلب (اختياري)" Style="{StaticResource FormLabel}"/>
                            <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,20">
                                <TextBox.Text>
                                    <Binding Path="ReorderLevel"
                                 UpdateSourceTrigger="PropertyChanged"
                                 TargetNullValue=""/>
                                </TextBox.Text>
                            </TextBox>

                            <Border Background="#FFF8E1" CornerRadius="8" Padding="12,8">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#856404">
                        <Run Text="ℹ "/>
                        <Run Text="الفصيلة تُحدَّد عند إدخال الوحدات في شاشة مخزون الدم، وليست جزءاً من تعريف الصنف."/>
                                </TextBlock>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>