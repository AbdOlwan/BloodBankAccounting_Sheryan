<UserControl x:Class="BloodBankAccounting.Views.BloodInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BloodBankAccounting.Converters">

    <UserControl.Resources>
        <converters:EnumDisplayConverter     x:Key="EnumDisplay"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <!-- [WHEEL] x:Name + PreviewMouseWheel للـ Shift+Wheel الأفقي -->
    <ScrollViewer x:Name="OuterScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OuterScroll_PreviewMouseWheel">

        <Grid Margin="20" MinWidth="540">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="2*" MaxWidth="360" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- ════ COLUMN 0: جدول المخزون الحالي ════════════════════ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <DockPanel>

                    <!-- ── رأس الجدول ── -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="المخزون الحالي"
                                   FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"/>

                        <Button Content="🔄"
                                Command="{Binding RefreshCommand}"
                                Width="36" Height="32"
                                Margin="0,0,8,0"
                                ToolTip="تحديث"
                                DockPanel.Dock="Left"
                                Style="{StaticResource SecondaryButton}"
                                Padding="0"/>

                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Tag="بحث بالصنف..."/>
                    </DockPanel>

                    <!-- ── الجدول ── -->
                    <DataGrid Style="{StaticResource MainDataGrid}"
                              ItemsSource="{Binding StockRows}"
                              IsReadOnly="True">
                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="الصنف" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Product.Name}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Product.Name}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الفصيلة" Width="*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding BloodGroup,
                                                                Converter={StaticResource EnumDisplay}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BloodGroup}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Text" Value="—"/>
                                                            <Setter Property="Foreground" Value="#9AA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الكمية" Width="*" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="آخر تحديث"
                                               Binding="{Binding LastUpdated, StringFormat='d/M/yyyy'}"
                                               Width="*" MinWidth="100"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ════ COLUMN 1: لوحة الإدخال + قائمة الانتظار ══════════ -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Command="{Binding SaveAllCommand}"
                                Height="44"
                                Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🩸  حفظ الإضافات  "/>
                                <Border Background="#FFFFFF33"
                                        CornerRadius="10"
                                        Padding="8,2"
                                        Visibility="{Binding HasPendingEntries, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top"
                               Text="إضافة للمخزون"
                               FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,16"/>

                    <!-- [WHEEL] FormScroll: يبلّغ الـ Outer عند الوصول للحد -->
                    <ScrollViewer x:Name="FormScroll"
                                  DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                        <StackPanel>

                            <TextBlock Text="صنف الكيس *" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct}"
                                      Style="{StaticResource FormComboBox}"
                                      Margin="0,0,0,12"
                                      DisplayMemberPath="Name"/>

                            <TextBlock Text="فصيلة الدم" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding BloodGroups}"
                                      SelectedItem="{Binding SelectedBloodGroup}"
                                      Style="{StaticResource FormComboBox}"
                                      Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding Converter={StaticResource EnumDisplay}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                            <Setter Property="Text"   Value="بدون فصيلة"/>
                                                            <Setter Property="Foreground" Value="#9AA3AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="الكمية *" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     Margin="0,0,0,16">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddToPendingCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <Button Content="＋  إضافة للقائمة"
                                    Command="{Binding AddToPendingCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="38"
                                    Margin="0,0,0,16"/>

                            <Separator Margin="0,0,0,12"/>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding PendingEntries.Count,
                                               StringFormat='{}قائمة الإضافة ({0})'}"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="#3D5A73"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- [WHEEL] PendingScroll: يبلّغ الـ Outer عند الوصول للحد -->
                    <ScrollViewer x:Name="PendingScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding PendingEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E5E8EC"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,6"
                                            Padding="10,8">
                                        <DockPanel>

                                            <Button DockPanel.Dock="Left"
                                                    Content="✕"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    Foreground="#C0392B"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveFromPendingCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="حذف"/>

                                            <Border DockPanel.Dock="Right"
                                                    Background="#C0392B"
                                                    CornerRadius="12"
                                                    Padding="10,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Quantity}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="12"/>
                                            </Border>

                                            <StackPanel Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProductName}"/>
                                                <TextBlock FontSize="10.5" Foreground="#7D8FA8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text"
                                                                    Value="{Binding BloodGroup,
                                                                        Converter={StaticResource EnumDisplay}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BloodGroup}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Text" Value="بدون فصيلة"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
