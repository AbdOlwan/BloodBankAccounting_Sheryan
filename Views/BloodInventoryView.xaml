<UserControl x:Class="BloodBankAccounting.Views.BloodInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ════ LEFT: Bags list ════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="عرض: " VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding FilterStatus}"
                              Style="{StaticResource FormComboBox}"
                              Width="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <DataGrid Style="{StaticResource MainDataGrid}"
                          ItemsSource="{Binding Bags}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الكيس"
                                           Binding="{Binding BagNumber}" Width="130"/>
                        <DataGridTextColumn Header="الفصيلة"
                                           Binding="{Binding BloodGroup, Converter={StaticResource EnumDisplay}}" Width="80"/>
                        <DataGridTextColumn Header="سعر التكلفة"
                                           Binding="{Binding CostPrice, StringFormat='{}{0:N2}'}" Width="110"/>
                        <DataGridTextColumn Header="سعر البيع"
                                           Binding="{Binding SalePrice, StringFormat='{}{0:N2}'}" Width="110"/>
                        <DataGridTextColumn Header="تاريخ الانتهاء"
                                           Binding="{Binding ExpiryDate, StringFormat='d/M/yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="الحالة"
                                           Binding="{Binding Status, Converter={StaticResource EnumDisplay}}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Expiring soon -->
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource ExpiringBagConverter}">
                                            <Binding Path="ExpiryDate"/>
                                            <Binding Path="Status"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="#FFF3CD"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ════ RIGHT: Add bag form ════════════════════════ -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="إضافة كيس جديد" FontWeight="Bold"
                           FontSize="14" Margin="0,0,0,20"/>

                <!-- ══ رقم الكيس — حقل مسح الباركود ══════════ -->
                <TextBlock Text="رقم الكيس *" Style="{StaticResource FormLabel}"/>

                <!-- حاوية الحقل المركّب -->
                <Border x:Name="BarcodeFieldBorder"
                        Margin="0,0,0,14"
                        CornerRadius="8"
                        BorderThickness="1.5"
                        BorderBrush="#E5E8EC"
                        Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- العمود 0 يظهر على اليمين في RTL → أيقونة الباركود -->
                            <ColumnDefinition Width="44"/>
                            <!-- العمود 1 يمتد يساراً → حقل الإدخال -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ── أيقونة الماسح الضوئي (يمين) ────────── -->
                        <Border x:Name="ScanIconBorder"
                                Grid.Column="0"
                                Background="#1A2744"
                                CornerRadius="0,6,6,0"
                                Cursor="Hand"
                                ToolTip="انقر ثم وجّه الماسح الضوئي نحو الباركود"
                                MouseLeftButtonUp="ScanIconBorder_Click">
                            <!-- مقلّد باركود بمستطيلات -->
                            <Canvas Width="22" Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Rectangle Canvas.Left="0"  Width="3" Height="18" Fill="White"/>
                                <Rectangle Canvas.Left="5"  Width="1" Height="18" Fill="White"/>
                                <Rectangle Canvas.Left="8"  Width="2" Height="18" Fill="White"/>
                                <Rectangle Canvas.Left="12" Width="3" Height="18" Fill="White"/>
                                <Rectangle Canvas.Left="17" Width="1" Height="18" Fill="White"/>
                                <Rectangle Canvas.Left="20" Width="2" Height="18" Fill="White"/>
                            </Canvas>
                        </Border>

                        <!-- ── حقل إدخال رقم الكيس ──────────────────── -->
                        <TextBox x:Name="TxtBagNumber"
                                 Grid.Column="1"
                                 Text="{Binding BagNumber, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Height="38">
                            <!-- Enter = إضافة الكيس مباشرة -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddBagCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- تلميح الاستخدام -->
                <TextBlock Margin="0,-10,0,14"
                           FontSize="10.5"
                           Foreground="#7D8FA8">
                    <Run Text="💡"/>
                    <Run Text=" وجّه الماسح نحو الباركود أو اكتب الرقم واضغط Enter"/>
                </TextBlock>
                <!-- ════════════════════════════════════════════ -->

                <TextBlock Text="الفصيلة *" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding BloodGroups}"
                          SelectedItem="{Binding BloodGroup}"
                          Style="{StaticResource FormComboBox}"
                          Margin="0,0,0,14">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="سعر التكلفة (ج.م)" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="سعر البيع (ج.م) *" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="تاريخ الانتهاء *" Style="{StaticResource FormLabel}"/>
                <DatePicker SelectedDate="{Binding ExpiryDate}"
                            Margin="0,0,0,24"/>

                <Button Content="🩸  إضافة الكيس"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddBagCommand}"
                        Height="44"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
