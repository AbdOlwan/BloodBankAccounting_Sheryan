<UserControl x:Class="BloodBankAccounting.Views.OrganizationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780">

            <!-- ═══ قسم بيانات البنك ═══════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>

                    <TextBlock Text="🏥  بيانات بنك الدم"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#1A2744" Margin="0,0,0,20"/>

                    <TextBlock Text="اسم بنك الدم *" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="العنوان الفرعي (يظهر أسفل الاسم في المطبوعات)"
                               Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding SubTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     FlowDirection="LeftToRight" TextAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="العنوان / المدينة" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- شعار -->
                    <TextBlock Text="شعار البنك  (PNG/JPG — يظهر في رأس كل مطبوع)"
                               Style="{StaticResource FormLabel}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 IsReadOnly="True" Foreground="#6E6E73"
                                 FlowDirection="LeftToRight"/>
                        <Button Grid.Column="2" Content="📁  تصفح"
                                Command="{Binding BrowseLogoCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="90" Height="40"/>
                        <Button Grid.Column="4" Content="✕  حذف"
                                Command="{Binding RemoveLogoCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="72" Height="40"
                                Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                    <Border Margin="0,12,0,0" MaxHeight="80" MaxWidth="200"
                            HorizontalAlignment="Right"
                            BorderBrush="#E5E8EC" BorderThickness="1"
                            CornerRadius="8" Background="#F8F9FA"
                            Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="8"/>
                    </Border>

                    <!-- حفظ بيانات البنك -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   FontSize="12" VerticalAlignment="Center" Foreground="#27AE60"/>
                        <Button Grid.Column="1" Content="💾  حفظ بيانات البنك"
                                Command="{Binding SaveOrgInfoCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="190" Height="44" FontSize="13"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ═══ قسم الرمز السري ══════════════════════════════ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔐  الرمز السري للبيانات المالية"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#1A2744" VerticalAlignment="Center"/>
                        <Border Background="#FEF2F2" CornerRadius="12"
                                Padding="10,4" Margin="12,0,0,0"
                                Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="✓  مُفعَّل" Foreground="#C0392B"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#F0FFF4" CornerRadius="12"
                                Padding="10,4" Margin="12,0,0,0"
                                Visibility="{Binding HasPin, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="غير مُفعَّل" Foreground="#6E6E73" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Margin="0,4,0,16" FontSize="12" Foreground="#6E6E73"
                               TextWrapping="Wrap"
                               Text="الرمز السري يُخفي مبيعات اليوم ورصيد الخزينة وإجمالي الديون عن باقي المستخدمين في لوحة التحكم."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="الرمز الحالي" Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="CurrentPinBox" PasswordChar="●"
                                         Height="42" FontSize="18" MaxLength="20"
                                         Padding="12,0" BorderBrush="#D2D2D7" BorderThickness="1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الرمز الجديد" Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="NewPinBox" PasswordChar="●"
                                         Height="42" FontSize="18" MaxLength="20"
                                         Padding="12,0" BorderBrush="#D2D2D7" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="🗑  إزالة الرمز"
                                Click="OnRemovePinClick"
                                Style="{StaticResource SecondaryButton}"
                                Height="40" Padding="16,0" Margin="0,0,10,0"
                                Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="🔐  حفظ الرمز السري"
                                Click="OnChangePinClick"
                                Style="{StaticResource PrimaryButton}"
                                Height="42" Padding="20,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding PinStatusMessage}"
                               FontSize="12" FontWeight="SemiBold"
                               Margin="0,10,0,0" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#27AE60"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPinError}" Value="True">
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
