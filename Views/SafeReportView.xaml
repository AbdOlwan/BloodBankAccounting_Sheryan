<UserControl x:Class="BloodBankAccounting.Views.SafeReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BloodBankAccounting.ViewModels"
             xmlns:conv="clr-namespace:BloodBankAccounting.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SafeReportViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: العنوان + زر القفل -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="كشف حساب الخزينة"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#C0392B" HorizontalAlignment="Right"/>
            <Button Grid.Column="0" Command="{Binding ToggleFinancialLockCommand}"
                    Background="#C0392B" Foreground="White"
                    Padding="12,6" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LockIcon}" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LockButtonText}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#922B21"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Row 1: فلاتر -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="الخزينة:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Safes}" SelectedItem="{Binding SelectedSafe}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource FormComboBox}" Width="180" Margin="0,0,16,0"/>
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding From}" Margin="0,0,16,0"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding To}" Margin="0,0,16,0"/>
                <Button Content="🔍  عرض" Command="{Binding LoadStatementCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>

        <!-- Row 2: ملخص الأرصدة -->
        <Border Grid.Row="2" Background="#F5F5F7" BorderBrush="#D2D2D7" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding IsFinancialUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="الرصيد الافتتاحي" FontSize="10" Foreground="#6E6E73"/>
                    <TextBlock Text="{Binding OpeningBalance, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="#1A5276"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي الوارد" FontSize="10" Foreground="#6E6E73"/>
                    <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="#1E8449"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="إجمالي الصادر" FontSize="10" Foreground="#6E6E73"/>
                    <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="#7B241C"/>
                </StackPanel>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="الرصيد الحالي" FontSize="10" Foreground="#6E6E73"/>
                    <TextBlock Text="{Binding ClosingBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#C0392B"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#F5F5F7" BorderBrush="#D2D2D7" BorderThickness="1"
                CornerRadius="10" Padding="24" Margin="0,0,0,12"
                Visibility="{Binding IsFinancialUnlocked, Converter={StaticResource InvBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="🔒" FontSize="20" Margin="0,0,12,0"/>
                <TextBlock Text="البيانات المالية مخفية — اضغط عرض البيانات لفتح القفل"
                           FontSize="13" Foreground="#6E6E73" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Row 3: زر طباعة كل الحركات (أحمر كبير) -->
        <Button Grid.Row="3" Margin="0,0,0,12" Height="52"
                Command="{Binding PrintCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="12" Background="#C0392B">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F5A8;&#xFE0F;" FontSize="20"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="طباعة جميع الحركات"
                                           Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Foreground="#FFAAAA" FontSize="11">
                                    <Run Text="("/>
                                    <Run Text="{Binding Entries.Count, Mode=OneWay}"/>

                                    <Run Text=" حركة)"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#922B21"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="#CCCCCC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Row 4: جدول الحركات -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F2F5"
                      BorderThickness="0" Background="White"
                      RowBackground="White" AlternatingRowBackground="#FAFBFC"
                      FontSize="13" ColumnHeaderHeight="40">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding Date, StringFormat=d/M/yyyy}" Width="100"/>
                    <DataGridTextColumn Header="النوع"
                                        Binding="{Binding RefTypeDisplay}" Width="80"/>
                    <DataGridTextColumn Header="البيان"
                                        Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="وارد"
                                        Binding="{Binding Debit, StringFormat=N2}" Width="110"
                                        Visibility="{Binding DataContext.IsFinancialUnlocked,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVis}}"/>
                    <DataGridTextColumn Header="صادر"
                                        Binding="{Binding Credit, StringFormat=N2}" Width="110"
                                        Visibility="{Binding DataContext.IsFinancialUnlocked,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVis}}"/>
                    <DataGridTextColumn Header="الرصيد"
                                        Binding="{Binding Balance, StringFormat=N2}" Width="120"
                                        FontWeight="Bold"
                                        Visibility="{Binding DataContext.IsFinancialUnlocked,
                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                            Converter={StaticResource BoolToVis}}"/>

                    <!-- زر طباعة لكل صف -->
                    <DataGridTemplateColumn Header="طباعة" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="70" Height="28" Cursor="Hand"
                                        ToolTip="طباعة تفاصيل هذه الحركة"
                                        Command="{Binding DataContext.PrintEntryCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="rb" CornerRadius="6" Background="#C0392B">
                                                <TextBlock Text="&#x1F5A8;&#xFE0F; طباعة"
                                                           Foreground="White" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="rb" Property="Background" Value="#922B21"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
