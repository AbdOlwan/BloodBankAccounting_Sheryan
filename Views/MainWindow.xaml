<Window x:Class="BloodBankAccounting.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BloodBankAccounting.ViewModels"
        Title="بنك الدم — نظام المحاسبة"
        WindowState="Maximized"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Icon="/Resources/sharyan.ico"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MaxWidth="260" MinWidth="160"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════ SIDEBAR ══════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>

                <!-- Logo — 5 ضغطات سريعة تفتح لوحة المطوّر -->
                <Border DockPanel.Dock="Top"
                        Padding="16,20,16,16"
                        BorderBrush="#FFFFFF22" BorderThickness="0,0,0,1"
                        
                        Cursor="Arrow">
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryBrush}"
                                CornerRadius="10"
                                Width="40" Height="40"
                                HorizontalAlignment="Right">
                            <Image Source="/Resources/sharyan.ico"
                                   Width="26" Height="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="شريان"
                                   Foreground="White"
                                   FontSize="18" FontWeight="Bold"
                                   Margin="0,8,0,2"/>
                        <TextBlock Text="نظام محاسبة بنك الدم"
                                   Foreground="#AAAAAA" FontSize="10"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Nav Items -->
                <ScrollViewer DockPanel.Dock="Top"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">

                        <TextBlock Text="الرئيسية" Foreground="#666666"
                                   FontSize="9" FontWeight="Bold"
                                   Margin="8,0,8,6"/>
                        <!--
                            Tag يُطابَق مع ActivePage في الـ ViewModel
                            لإضاءة الزر النشط بالـ NavButton trigger.
                        -->
                        <Button Tag="Dashboard"
                                Command="{Binding NavigateToDashboardCommand}"
                                Style="{StaticResource NavButton}"
                                Content="📊  لوحة التحكم"/>

                        <TextBlock Text="المعاملات" Foreground="#666666"
                                   FontSize="9" FontWeight="Bold"
                                   Margin="8,14,8,6"/>
                        <Button Tag="Invoice"
                                Command="{Binding NavigateToInvoiceCommand}"
                                Style="{StaticResource NavButton}"
                                Content="🧾  فاتورة جديدة"/>
                        <Button Tag="InvoiceList"
                                Command="{Binding NavigateToInvoiceListCommand}"
                                Style="{StaticResource NavButton}"
                                Content="📋  سجل الفواتير"/>
                        <Button Tag="Receipt"
                                Command="{Binding NavigateToReceiptCommand}"
                                Style="{StaticResource NavButton}"
                                Content="⬇️  سند قبض"/>
                        <Button Tag="Payment"
                                Command="{Binding NavigateToPaymentCommand}"
                                Style="{StaticResource NavButton}"
                                Content="⬆️  سند دفع"/>

                        <TextBlock Text="البيانات" Foreground="#666666"
                                   FontSize="9" FontWeight="Bold"
                                   Margin="8,14,8,6"/>
                        <Button Tag="Customers"
                                Command="{Binding NavigateToCustomersCommand}"
                                Style="{StaticResource NavButton}"
                                Content="👤  العملاء"/>
                        <Button Tag="BloodInventory"
                                Command="{Binding NavigateToBloodInventoryCommand}"
                                Style="{StaticResource NavButton}"
                                Content="🩸  مخزون الدم"/>

                        <TextBlock Text="التقارير" Foreground="#666666"
                                   FontSize="9" FontWeight="Bold"
                                   Margin="8,14,8,6"/>
                        <!--
                            تقرير الديون: عند الضغط يُطلَق DebtReportAccessRequested
                            في MainWindow.xaml.cs — لا ينتقل مباشرة.
                        -->
                        <Button Tag="DebtReport"
                                Command="{Binding NavigateToDebtReportCommand}"
                                Style="{StaticResource NavButton}"
                                Content="📉  تقرير الديون"/>
                        <Button Tag="SafeReport"
                                Command="{Binding NavigateToSafeReportCommand}"
                                Style="{StaticResource NavButton}"
                                Content="🏦  الخزينة"/>

                        <TextBlock Text="الإعدادات" Foreground="#666666"
                                   FontSize="9" FontWeight="Bold"
                                   Margin="8,14,8,6"/>
                        <Button Tag="OrgSettings"
                                Command="{Binding NavigateToOrgSettingsCommand}"
                                Style="{StaticResource NavButton}"
                                Content="⚙️  إعدادات المؤسسة"/>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ════════════ CONTENT AREA ════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0" MinHeight="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentPageTitle}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               xmlns:system="clr-namespace:System;assembly=mscorlib"
                               Text="{Binding Source={x:Static system:DateTime.Now},
                                              StringFormat='dddd، d MMMM yyyy'}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Page content via DataTemplate -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>

        <!-- ════════════ FOOTER ═══════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                MinHeight="32"
                BorderThickness="0,1,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#111827" Offset="0"/>
                    <GradientStop Color="#1A2744" Offset="0.5"/>
                    <GradientStop Color="#111827" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A2744"  Offset="0"/>
                    <GradientStop Color="#C9A84C"  Offset="0.3"/>
                    <GradientStop Color="#E8D5A3"  Offset="0.5"/>
                    <GradientStop Color="#C9A84C"  Offset="0.7"/>
                    <GradientStop Color="#1A2744"  Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Height="1" VerticalAlignment="Center"
                           Margin="24,0,16,0" Opacity="0.25">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#C9A84C"     Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,6">
                    <TextBlock Text="✦" Foreground="#C9A84C" FontSize="7"
                               VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8"/>
                    <TextBlock Text="تصميم وبرمجة" Foreground="#6B82A8"
                               FontSize="10" VerticalAlignment="Center"
                               FontFamily="Segoe UI, Tahoma, Arial" Margin="0,0,6,0"/>
                    <TextBlock Text="مهندس عبدالرحمن علوان"
                               Foreground="#EAD9B0" FontSize="11" FontWeight="SemiBold"
                               FontFamily="Segoe UI, Tahoma, Arial" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Margin="12,0" VerticalAlignment="Center" Opacity="0.4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#C9A84C"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="0112 7136 834"
                               Foreground="#C9A84C" FontSize="11" FontWeight="SemiBold"
                               FontFamily="Consolas, Courier New, monospace"
                               VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                    <TextBlock Text="✦" Foreground="#C9A84C" FontSize="7"
                               VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8"/>

                    <!-- ── مؤشر النسخ الاحتياطي ── -->
                    <Border Width="1" Height="14" Margin="12,0" VerticalAlignment="Center" Opacity="0.4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#C9A84C"     Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="💾"
                               FontSize="10" VerticalAlignment="Center"
                               Margin="0,0,4,0" Opacity="0.7"/>
                    <TextBlock Text="{Binding BackupStatus}"
                               Foreground="#6B82A8" FontSize="10"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI, Tahoma, Arial"/>
                </StackPanel>

                <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                           Margin="16,0,24,0" Opacity="0.25">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C9A84C" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Border>

    </Grid>
</Window>
