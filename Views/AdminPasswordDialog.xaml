<Window x:Class="BloodBankAccounting.Views.AdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحذير — منطقة محظورة"
        Width="460" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D0D0D" Offset="0"/>
            <GradientStop Color="#1A0000" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <StackPanel Margin="32,28,32,28">

        <!-- أيقونة تحذير -->
        <TextBlock Text="⛔"
                   FontSize="42"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- عنوان -->
        <TextBlock Text="منطقة مقيّدة للمطوّر فقط"
                   FontSize="17" FontWeight="Bold"
                   Foreground="#E74C3C"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6"/>

        <!-- تحذيرات -->
        <Border Background="#1A0A0A"
                BorderBrush="#C0392B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,8,0,18">
            <StackPanel>
                <TextBlock Foreground="#E74C3C" FontSize="11" FontWeight="Bold"
                           Text="⚠  تحذيرات هامة:" Margin="0,0,0,6"/>
                <TextBlock Foreground="#CC6666" FontSize="11" TextWrapping="Wrap"
                           Text="• أي عملية هنا لا يمكن التراجع عنها نهائياً."
                           Margin="0,2"/>
                <TextBlock Foreground="#CC6666" FontSize="11" TextWrapping="Wrap"
                           Text="• حذف البيانات يعني فقدانها إلى الأبد."
                           Margin="0,2"/>
                <TextBlock Foreground="#CC6666" FontSize="11" TextWrapping="Wrap"
                           Text="• أنت مسؤول عن كل عملية تُنفَّذ من هنا."
                           Margin="0,2"/>
                <TextBlock Foreground="#AA4444" FontSize="11" TextWrapping="Wrap" FontWeight="Bold"
                           Text="• إذا لم تكن المطوّر، أغلق هذه النافذة فوراً."
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- حقل كلمة السر -->
        <TextBlock Text="كلمة المرور الخاصة بالمطوّر:"
                   Foreground="#888" FontSize="12"
                   Margin="0,0,0,6"/>
        <PasswordBox x:Name="PwdBox"
                     Height="38"
                     FontSize="14"
                     Background="#1E1E1E"
                     Foreground="White"
                     BorderBrush="#555"
                     BorderThickness="1"
                     Padding="10,4"
                     KeyDown="PwdBox_KeyDown"/>

        <!-- رسالة خطأ -->
        <TextBlock x:Name="TxtError"
                   Foreground="#E74C3C"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"
                   Text="❌  كلمة المرور غير صحيحة"/>

        <!-- أزرار -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="BtnConfirm"
                    Content="✔  دخول"
                    Height="38" FontSize="13" FontWeight="Bold"
                    Background="#C0392B" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnConfirm_Click"/>

            <Button Grid.Column="2"
                    Content="✖  إلغاء"
                    Height="38" FontSize="13"
                    Background="#2C2C2C" Foreground="#AAA"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
        </Grid>

    </StackPanel>
</Window>
