<UserControl x:Class="BloodBankAccounting.Views.InvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ✅ التغييرات للتجاوب:
        1. شريط الفلتر: StackPanel Orientation="Horizontal" قد يتجاوز عرض الشاشة
           → استبدلناه بـ Grid بأعمدة محددة تبقى على سطر واحد وتملأ العرض المتاح
        2. زر العرض يمتد ليملأ العرض المتبقي بدل حجم ثابت
        3. Margin الخارجي: "24" → "20"
    -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
            <!-- ✅ Grid بدل StackPanel: يضمن عدم تجاوز شريط الفلتر للعرض المتاح -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="من:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1"
                            SelectedDate="{Binding From}" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="إلى:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="3"
                            SelectedDate="{Binding To}" Margin="0,0,14,0"/>
                <!-- العمود 4 فارغ → يمتص المسافة المتبقية -->
                <Button Grid.Column="5"
                        Content="🔍  عرض"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <!-- Invoices grid -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid Style="{StaticResource MainDataGrid}"
                      ItemsSource="{Binding Invoices}"
                      x:Name="InvoicesGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة"
                                       Binding="{Binding InvoiceNumber}" Width="150"/>
                    <DataGridTextColumn Header="التاريخ"
                                       Binding="{Binding Date, StringFormat='d/M/yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="العميل"
                                       Binding="{Binding Customer.Name}" Width="*"/>
                    <DataGridTextColumn Header="نوع الدفع"
                                       Binding="{Binding PaymentType, Converter={StaticResource EnumDisplay}}" Width="90"/>
                    <DataGridTextColumn Header="الإجمالي"
                                       Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" Width="110"/>
                    <DataGridTextColumn Header="المحصل"
                                       Binding="{Binding PaidAmount, StringFormat='{}{0:N2}'}" Width="110"/>
                    <DataGridTemplateColumn Header="الحالة" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D5F5E3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                    <Setter Property="Background" Value="#FADBD8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓ مكتمل"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                        <Setter Property="Text" Value="✗ ملغي"/>
                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="إجراء" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🖨 طباعة"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#1A2744" FontSize="12" Cursor="Hand"
                                            Command="{Binding DataContext.PrintInvoiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="إلغاء"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#C0392B" FontSize="12" Cursor="Hand"
                                            Command="{Binding DataContext.CancelInvoiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding IsCancelled, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
