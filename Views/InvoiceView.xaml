<UserControl x:Class="BloodBankAccounting.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BloodBankAccounting.ViewModels"
             xmlns:conv="clr-namespace:BloodBankAccounting.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             FontFamily="Segoe UI"
             d:DataContext="{d:DesignInstance Type=vm:InvoiceViewModel}">

    <UserControl.Resources>
        <!-- Converters الأصلية — لم تُعدّل -->
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:InverseBoolConverter             x:Key="InverseBoolConverter"/>
        <conv:EnumDisplayConverter             x:Key="EnumDisplay"/>

        <!-- ═══════════════════════════════════════ -->
        <!-- Styles بصرية جديدة — UI فقط             -->
        <!-- ═══════════════════════════════════════ -->

        <!-- خلفية البطاقة الرئيسية -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- خلفية بطاقة الشريط الجانبي (Sidebar) -->
        <Style x:Key="SidebarCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="4" Color="#000000" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تسمية الحقول -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- عنوان القسم -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <!-- عنوان فرعي أصغر -->
        <Style x:Key="SubSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <!-- رأس أعمدة DataGrid العصري -->
        <Style x:Key="ModernColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- صف DataGrid -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Animation خفيفة للـ Empty State -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
        </Storyboard>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- الخلفية العامة — لون رمادي ناعم يبرز البطاقات البيضاء   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Border Background="#F1F5F9">
        <DockPanel Margin="28,28,28,28" LastChildFill="True">

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 3. شريط الإجراءات السفلي (Action Bar)              -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="16"
                    Padding="28,0" Height="80" Margin="0,20,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- حفظ الفاتورة -->
                    <Button Grid.Column="0" Cursor="Hand"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="saveBtn" CornerRadius="12" Background="#1E293B" Padding="28,16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#1E293B" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="حفظ الفاتورة" Foreground="White" FontSize="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="saveBtn" Property="Background" Value="#334155"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="saveBtn" Property="Background" Value="#CBD5E1"/>
                                        <Setter TargetName="saveBtn" Property="Effect" Value="{x:Null}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- حفظ وطباعة -->
                    <Button Grid.Column="2" Cursor="Hand"
                            Command="{Binding SaveAndPrintCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="printBtn" CornerRadius="12" Background="#BE123C" Padding="28,16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#BE123C" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="حفظ وطباعة" Foreground="White" FontSize="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="printBtn" Property="Background" Value="#9F1239"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="printBtn" Property="Background" Value="#CBD5E1"/>
                                        <Setter TargetName="printBtn" Property="Effect" Value="{x:Null}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 2. اللوحة الجانبية الذكية (Smart Sidebar)           -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Right" Width="340" Margin="24,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ─── ملخص الفاتورة ─── -->
                        <Border Style="{StaticResource SidebarCard}">
                            <StackPanel>
                                <TextBlock Text="ملخص الفاتورة" Style="{StaticResource SectionHeader}" Margin="0,0,0,16"/>

                                <!-- فاصل تحت العنوان -->
                                <Border Height="1" Background="#F1F5F9" Margin="0,0,0,16"/>

                                <!-- صف الإجمالي قبل الخصم -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="الإجمالي قبل الخصم"
                                               FontSize="13" Foreground="#64748B"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SubTotal, StringFormat='{}{0:N2} ج.م'}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#334155"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- فاصل خفيف بين السطور -->
                                <Border Height="1" Background="#F1F5F9" Margin="0,0,0,12"/>

                                <!-- صف الخصم — TextBox قابل للتعديل بدلاً من TextBlock ثابت -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="الخصم (ج.م)"
                                               FontSize="13" Foreground="#64748B"
                                               VerticalAlignment="Center"/>
                                    <!-- TextBox مرتبط مباشرة بـ DiscountAmount — Mode=TwoWay لضمان الكتابة للـ ViewModel -->
                                    <Border Grid.Column="2"
                                            Background="#FFFBF0" CornerRadius="8"
                                            BorderBrush="#FCD34D" BorderThickness="1">
                                        <TextBox Text="{Binding DiscountAmount, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 FontSize="13" FontWeight="SemiBold" Foreground="#92400E"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="10,6" VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 ToolTip="أدخل قيمة الخصم بالجنيه"/>
                                    </Border>
                                </Grid>

                                <Border Background="#FFF1F2" CornerRadius="12" Padding="18,14" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="الإجمالي النهائي" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#BE123C"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#BE123C"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="#FFF7ED" CornerRadius="12" Padding="18,14" Margin="0,14,0,0"
                                        Visibility="{Binding IsPartialVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="المتبقي على العميل" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#C2410C"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RemainingAfterInitial, StringFormat='{}{0:N2} ج.م'}"
                                                   FontSize="16" FontWeight="Bold" Foreground="#EA580C"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ─── إضافة من المخزون ─── -->
                        <Border Style="{StaticResource SidebarCard}">
                            <StackPanel>
                                <!-- رأس القسم -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Background="#EEF2FF" CornerRadius="8" Padding="8,6" Margin="0,0,10,0">
                                        <TextBlock Text="📦" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="إضافة من المخزون" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- فاصل -->
                                <Border Height="1" Background="#F1F5F9" Margin="0,0,0,16"/>

                                <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StockProducts}"
                                          SelectedItem="{Binding SelectedStockProduct}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FormComboBox}"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="الفصيلة" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StockBloodGroups}"
                                          SelectedItem="{Binding SelectedStockBloodGroup}"
                                          Style="{StaticResource FormComboBox}"
                                          Margin="0,0,0,16">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="#F0FDF4" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="المتاح: " FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AvailableQty}" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                                        <TextBlock Text=" وحدة" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding StockQty, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}" FontSize="15" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="السعر الافتراضي (ج.م)" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SelectedStockProduct.DefaultSalePrice, StringFormat='{}{0:N2}'}"
                                                       FontSize="15" FontWeight="Bold" Foreground="#1E293B"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- ملاحظة توضيحية للمستخدم -->
                                <Border Background="#FFF9F0" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                    <TextBlock Text="💡 يمكنك تعديل سعر الوحدة يدوياً داخل جدول الفاتورة عند الحاجة"
                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                                </Border>

                                <Button Height="48" Cursor="Hand" Command="{Binding AddStockLineCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ab" CornerRadius="10" Background="#1E293B">
                                                <TextBlock Text="➕  إضافة للفاتورة" Foreground="White" FontSize="13"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ab" Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 1. منطقة العمل الرئيسية (Work Canvas)               -->
            <!-- ═══════════════════════════════════════════════════ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>

                    <!-- ─── Header: معلومات الفاتورة الأساسية ─── -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم الفاتورة" Style="{StaticResource FieldLabel}"/>
                                <Border Background="#FFF1F2" CornerRadius="10" Padding="16,10">
                                    <TextBlock Text="{Binding InvoiceNumber}" FontSize="16" FontWeight="Bold" Foreground="#BE123C"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="التاريخ" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding Date}" FontSize="13" MinWidth="150"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="طريقة الدفع" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PaymentTypes}"
                                          SelectedItem="{Binding PaymentType}"
                                          MinWidth="180">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ─── بيانات العميل ─── -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العميل *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Name"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FormComboBox}"
                                          FontSize="14"
                                          ToolTip="ابدأ بالكتابة للبحث، أو اختر من القائمة"/>
                            </StackPanel>

                            <!-- بطاقة العميل المختار -->
                            <Border Grid.Column="2"
                                    Background="#F0FDF4" CornerRadius="12" Padding="18,14" MinWidth="240"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCustomer.Name}"
                                               FontWeight="Bold" FontSize="14" Foreground="#047857"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="📞 " FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedCustomer.Phone}" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="رصيده: " FontSize="12" Foreground="#475569"/>
                                        <TextBlock Text="{Binding SelectedCustomer.Balance, StringFormat=N2}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                        <TextBlock Text=" ج.م" FontSize="12" Foreground="#475569"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Empty State العميل -->
                            <Border Grid.Column="2"
                                    Background="#F8FAFC" CornerRadius="12" Padding="18,14" MinWidth="240"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center" Opacity="0.4"/>
                                    <TextBlock Text="لم يُختر عميل بعد"
                                               FontSize="13" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ─── إضافة عميل سريع (Visible) ─── -->
                    <Border Style="{StaticResource CardBorder}"
                            Background="#F0FDF4" BorderBrush="#A7F3D0"
                            Visibility="{Binding IsQuickAddVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="✚" Foreground="#059669" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="إضافة عميل جديد" FontSize="14" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="اسم العميل *" Style="{StaticResource FieldLabel}" Foreground="#059669"/>
                                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="النوع" Style="{StaticResource FieldLabel}" Foreground="#059669"/>
                                    <ComboBox ItemsSource="{Binding CustomerTypes}"
                                              SelectedItem="{Binding NewCustomerType}"
                                              Style="{StaticResource FormComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Command="{Binding QuickSaveCustomerCommand}"
                                        VerticalAlignment="Bottom" Height="44" Padding="20,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="sb" CornerRadius="8" Background="#059669">
                                                <TextBlock Text="✔  حفظ" Foreground="White" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="sb" Property="Background" Value="#047857"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="6"
                                        Command="{Binding ToggleQuickAddCommand}"
                                        VerticalAlignment="Bottom" Height="44" Padding="16,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="xb" CornerRadius="8" Background="#E2E8F0">
                                                <TextBlock Text="✖" Foreground="#334155" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="xb" Property="Background" Value="#CBD5E1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ─── زر تبديل إضافة عميل (Collapsed) ─── -->
                    <Border Visibility="{Binding IsQuickAddVisible, Converter={StaticResource InvBoolToVis}}"
                            Margin="0,-4,0,12">
                        <Button HorizontalAlignment="Left"
                                Command="{Binding ToggleQuickAddCommand}"
                                Cursor="Hand" Height="40">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="nb" CornerRadius="8" Background="Transparent"
                                            BorderBrush="#059669" BorderThickness="1" Padding="16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="＋" FontSize="15" Foreground="#059669" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="إضافة عميل جديد" FontSize="13" Foreground="#059669"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="nb" Property="Background" Value="#F0FDF4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- ─── الخزينة والمدفوع ─── -->
                    <Border Style="{StaticResource CardBorder}"
                            Visibility="{Binding IsSafeVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الخزينة *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Safes}"
                                          SelectedItem="{Binding SelectedSafe}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FormComboBox}"
                                          ToolTip="اختر الخزينة المناسبة (نقدية أو إلكترونية)"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding IsPartialVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="المدفوع الآن (ج.م) *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding InitialPayment, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <Border Grid.Column="4"
                                    Visibility="{Binding IsPartialVisible, Converter={StaticResource BoolToVis}}"
                                    Background="#FFF7ED" CornerRadius="12" Padding="18,12"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="المتبقي على العميل" Style="{StaticResource FieldLabel}" Foreground="#C2410C"/>
                                    <TextBlock Text="{Binding RemainingAfterInitial, StringFormat='{}{0:N2} ج.م'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#EA580C"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ─── تفاصيل الدفع الإلكتروني ─── -->
                    <!-- ─── تأكيد الدفع الإلكتروني ─── -->
                    <Border Style="{StaticResource CardBorder}"
        Background="#EFF6FF" BorderBrush="#BFDBFE"
        Visibility="{Binding IsElectronicVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DBEAFE" CornerRadius="10" Padding="16,12" Margin="0,0,18,0">
                                <TextBlock Text="💳" FontSize="26" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="دفع إلكتروني" FontSize="15" FontWeight="Bold" Foreground="#1E40AF"/>
                                <TextBlock Text="سيُضاف المبلغ تلقائياً إلى الخزينة الإلكترونية"
                       FontSize="12" Foreground="#3B82F6" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Background="#DBEAFE" CornerRadius="8" Padding="14,6"
                Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="✓  موجّه تلقائياً" FontSize="12"
                       FontWeight="SemiBold" Foreground="#1D4ED8"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ─── DataGrid أصناف الفاتورة + Empty State ─── -->
                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <Border CornerRadius="16" ClipToBounds="True" Background="White">
                            <Grid MinHeight="240">
                                <DockPanel x:Name="DataGridContainer">
                                    <Border DockPanel.Dock="Top" Background="#F8FAFC"
                                            CornerRadius="16,16,0,0" Padding="24,18">
                                        <StackPanel>
                                            <TextBlock Text="أصناف الفاتورة"
                                                       Style="{StaticResource SectionHeader}"/>
                                            <TextBlock Text="انقر مرتين على سعر الوحدة أو الكمية للتعديل — السعر الافتراضي قابل للتغيير دون تأثير على قاعدة البيانات"
                                                       FontSize="11" Foreground="#94A3B8"
                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <DataGrid x:Name="InvoiceLinesGrid"
                                              ItemsSource="{Binding Lines}"
                                              IsReadOnly="False"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              RowBackground="Transparent"
                                              AlternatingRowBackground="#F8FAFC"
                                              GridLinesVisibility="None"
                                              HeadersVisibility="Column"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                              RowStyle="{StaticResource ModernDataGridRow}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الصنف / المنتج"
                                                                Binding="{Binding ProductName}"
                                                                Width="*" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="20,16"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- سعر الوحدة: قابل للتعديل اليدوي -->
                                            <!-- تغيير N2 → F2: يزيل فاصل الآلاف الذي يُفشل decimal.Parse عند التأكيد -->
                                            <DataGridTextColumn Header="سعر الوحدة (ج.م)"
                                                                Binding="{Binding UnitPrice, StringFormat='{}{0:F2}', UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="20,16"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Padding" Value="8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <!-- الكمية: قابلة للتعديل -->
                                            <DataGridTextColumn Header="الكمية"
                                                                Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="20,16"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Padding" Value="8"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="الإجمالي"
                                                                Binding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                                Width="120" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="20,16"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.RemoveLineCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="delBtn" CornerRadius="6" Background="Transparent" Padding="10">
                                                                        <TextBlock Text="🗑" FontSize="14" Opacity="0.5"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="delBtn" Property="Background" Value="#FEE2E2"/>
                                                                            <Setter TargetName="delBtn" Property="BorderBrush" Value="#FECACA"/>
                                                                            <Setter TargetName="delBtn" Property="BorderThickness" Value="1"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>

                                <!-- Empty State -->
                                <Border Background="#FAFBFC" CornerRadius="16"
                                        Visibility="{Binding HasItems, ElementName=InvoiceLinesGrid, Converter={StaticResource InvBoolToVis}}">
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48">
                                        <TextBlock Text="📋" FontSize="64" Opacity="0.12" HorizontalAlignment="Center"/>
                                        <TextBlock Text="لا توجد أصناف في الفاتورة" 
                                                   FontSize="16" Foreground="#94A3B8" 
                                                   HorizontalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="أضف صنفاً من المخزون أو اختر من أكياس الدم المتاحة في اللوحة الجانبية" 
                                                   FontSize="13" Foreground="#CBD5E1" 
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>