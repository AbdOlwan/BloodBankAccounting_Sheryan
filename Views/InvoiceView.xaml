<UserControl x:Class="BloodBankAccounting.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BloodBankAccounting.ViewModels"
             xmlns:conv="clr-namespace:BloodBankAccounting.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InvoiceViewModel}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <!-- ════════════════════════════════════════════════════════
         الهيكل الرئيسي: عمودان
         Left (*)  : رأس الفاتورة + جدول الأصناف + الإجماليات + حفظ
         Right (300): إضافة صنف يدوي + باركود + قائمة الأكياس
    ═══════════════════════════════════════════════════════════ -->
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════
             العمود الأيسر
        ════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: بطاقة رأس الفاتورة     -->
                <RowDefinition Height="*"/>
                <!-- 1: جدول الأصناف            -->
                <RowDefinition Height="Auto"/>
                <!-- 2: الإجماليات              -->
                <RowDefinition Height="Auto"/>
                <!-- 3: زر الحفظ               -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 Row 0 — رأس الفاتورة
            ═════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="White" BorderBrush="#E8EBF0" BorderThickness="1"
                    CornerRadius="14" Padding="20,16" Margin="0,0,0,12">

                <!-- شريط أعلوي ملوّن يدل على أنها فاتورة جديدة -->
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#1A2744" Opacity="0.06"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- الصف A: رقم + تاريخ + دفع      -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <!-- الصف B: العميل (محور التصميم) -->
                        <RowDefinition Height="Auto"/>
                        <!-- الصف C: نموذج عميل جديد        -->
                        <RowDefinition Height="Auto"/>
                        <!-- الصف D: الخزينة + جزئي         -->
                    </Grid.RowDefinitions>

                    <!-- ─── A: رقم الفاتورة / التاريخ / نوع الدفع ─── -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- رقم الفاتورة -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم الفاتورة"
                                       FontSize="10" Foreground="#8E8E93"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Background="#FFF0EE" CornerRadius="8" Padding="12,6">
                                <TextBlock Text="{Binding InvoiceNumber}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#C0392B"/>
                            </Border>
                        </StackPanel>

                        <!-- التاريخ -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="التاريخ"
                                       FontSize="10" Foreground="#8E8E93"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding Date}"
                                        FontSize="13" MinWidth="130"/>
                        </StackPanel>

                        <!-- Spacer -->
                        <StackPanel Grid.Column="3"/>

                        <!-- نوع الدفع -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="طريقة الدفع"
                                       FontSize="10" Foreground="#8E8E93"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding PaymentTypes}"
                                      SelectedItem="{Binding PaymentType}"
                                      Style="{StaticResource FormComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- ─── فاصل ─── -->
                    <Border Grid.Row="1" Height="1" Background="#F0F2F5"
                            VerticalAlignment="Center" Margin="0,4"/>

                    <!-- ─── B: منطقة العميل (التصميم الجديد) ─── -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- حقل البحث + القائمة المنسدلة -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="العميل *"
                                       FontSize="10" Foreground="#8E8E93"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>

                            <!-- حاوية ComboBox كـ AutoComplete -->
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FormComboBox}"
                                      FontSize="14"
                                      ToolTip="ابدأ بالكتابة للبحث، أو اختر من القائمة"/>
                        </StackPanel>

                        <!-- بطاقة معلومات العميل المختار (تظهر عند الاختيار) -->
                        <Border Grid.Column="2"
                                Background="#F0FFF4" BorderBrush="#27AE60"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,8" MinWidth="200"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.Name}"
                                           FontWeight="Bold" FontSize="13" Foreground="#1E8449"/>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="📞 " FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Phone}"
                                               FontSize="11" Foreground="#566573"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="رصيده: " FontSize="11" Foreground="#566573"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Balance, StringFormat=N2}"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="#E67E22"/>
                                    <TextBlock Text=" ج.م" FontSize="11" Foreground="#566573"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- أيقونة "لا يوجد عميل" عند عدم الاختيار -->
                        <Border Grid.Column="2"
                                Background="#F8F9FA" BorderBrush="#DEE2E6"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,8" MinWidth="200"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCustomer}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="👤" FontSize="22"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="لم يُختر عميل بعد"
                                           FontSize="11" Foreground="#AAAAAA"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ─── C: نموذج إضافة عميل جديد (قابل للإخفاء) ─── -->
                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Background="#F0FFF4"
                            BorderBrush="#27AE60" BorderThickness="1"
                            CornerRadius="10" Padding="16,12"
                            Visibility="{Binding IsQuickAddVisible, Converter={StaticResource BoolToVis}}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- رأس النموذج -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="7"
                                        Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="✚" Foreground="#27AE60"
                                           FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="إضافة عميل جديد"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#1E8449" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="اسم العميل *"
                                           FontSize="10" Foreground="#27AE60"
                                           FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="النوع"
                                           FontSize="10" Foreground="#27AE60"
                                           FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding CustomerTypes}"
                                          SelectedItem="{Binding NewCustomerType}"
                                          Style="{StaticResource FormComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- زر حفظ -->
                            <Button Grid.Column="4"
                                    Command="{Binding QuickSaveCustomerCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="36" Padding="14,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sb" CornerRadius="8" Background="#27AE60">
                                            <TextBlock Text="✔  حفظ" Foreground="White"
                                                       FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sb" Property="Background" Value="#1E8449"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- زر إلغاء -->
                            <Button Grid.Column="6"
                                    Command="{Binding ToggleQuickAddCommand}"
                                    VerticalAlignment="Bottom"
                                    Height="36" Padding="10,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="xb" CornerRadius="8"
                                                Background="#EEEEEE">
                                            <TextBlock Text="✖" Foreground="#555555"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="xb" Property="Background" Value="#DDDDDD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ─── زر إضافة عميل جديد (يظهر دائماً أسفل حقل العميل) ─── -->
                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Visibility="{Binding IsQuickAddVisible, Converter={StaticResource InvBoolToVis}}">
                        <Button HorizontalAlignment="Left"
                                Command="{Binding ToggleQuickAddCommand}"
                                Cursor="Hand" Height="30">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="nb" CornerRadius="8"
                                            Background="Transparent"
                                            BorderBrush="#27AE60" BorderThickness="1"
                                            Padding="12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="＋" FontSize="13"
                                                       Foreground="#27AE60" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="إضافة عميل جديد"
                                                       FontSize="12" Foreground="#27AE60"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="nb" Property="Background" Value="#F0FFF4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>

                    <!-- ─── D: الخزينة + الجزئي (مشروطة) ─── -->
                    <Border Grid.Row="4"
                            Margin="0,14,0,0"
                            Background="#F8F9FE" CornerRadius="10" Padding="14,10"
                            Visibility="{Binding IsSafeVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- الخزينة -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الخزينة *"
                                           FontSize="10" Foreground="#8E8E93"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Safes}"
                                          SelectedItem="{Binding SelectedSafe}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FormComboBox}"/>
                            </StackPanel>

                            <!-- المدفوع الآن (جزئي فقط) -->
                            <StackPanel Grid.Column="2"
                                        Visibility="{Binding IsPartialVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="المدفوع الآن (ج.م) *"
                                           FontSize="10" Foreground="#8E8E93"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding InitialPayment, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         FontSize="15" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- المتبقي (جزئي فقط) -->
                            <Border Grid.Column="4"
                                    Visibility="{Binding IsPartialVisible, Converter={StaticResource BoolToVis}}"
                                    Background="#FFF3E0" CornerRadius="10" Padding="14,8"
                                    VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="المتبقي على العميل"
                                               FontSize="10" Foreground="#8E8E93"
                                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding RemainingAfterInitial, StringFormat='{}{0:N2} ج.م'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#E67E22"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════
                 Row 1 — جدول الأصناف
            ═════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="White" BorderBrush="#E8EBF0" BorderThickness="1"
                    CornerRadius="14" Padding="0" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Color="#1A2744" Opacity="0.05"/>
                </Border.Effect>

                <DockPanel>
                    <!-- رأس الجدول -->
                    <Border DockPanel.Dock="Top"
                            Background="#F8F9FE" CornerRadius="14,14,0,0"
                            Padding="16,10">
                        <TextBlock Text="أصناف الفاتورة"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#1A2744"/>
                    </Border>

                    <DataGrid Style="{StaticResource MainDataGrid}"
                              ItemsSource="{Binding Lines}"
                              IsReadOnly="False"
                              BorderThickness="0"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف / المنتج"
                                                Binding="{Binding ProductName}"
                                                Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="السعر"
                                                Binding="{Binding UnitPrice, StringFormat='{}{0:N2}'}"
                                                Width="100"/>
                            <DataGridTextColumn Header="الكمية"
                                                Binding="{Binding Quantity}"
                                                Width="70"/>
                            <DataGridTextColumn Header="الإجمالي"
                                                Binding="{Binding Total, StringFormat='{}{0:N2}'}"
                                                Width="110" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Background="Transparent"
                                                BorderThickness="0" FontSize="15"
                                                Command="{Binding DataContext.RemoveLineCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand"
                                                ToolTip="حذف الصنف"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════════
                 Row 2 — الإجماليات
            ═════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="White" BorderBrush="#E8EBF0" BorderThickness="1"
                    CornerRadius="14" Padding="16,12" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Color="#1A2744" Opacity="0.05"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- خصم -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="خصم:" VerticalAlignment="Center"
                                   FontSize="13" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>

                    <!-- قبل الخصم + الإجمالي -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F5F5F7" CornerRadius="8" Padding="12,6" Margin="0,0,16,0">
                            <TextBlock FontSize="13">
                                <Run Text="قبل الخصم: " Foreground="#8E8E93"/>
                                <Run Text="{Binding SubTotal, StringFormat='{}{0:N2} ج.م'}"
                                     FontWeight="Bold" Foreground="#1A2744"/>
                            </TextBlock>
                        </Border>
                        <Border Background="#FFF0EE" CornerRadius="10" Padding="14,8">
                            <TextBlock FontSize="17" FontWeight="Bold" Foreground="#C0392B">
                                <Run Text="الإجمالي: "/>
                                <Run Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════
                 Row 3 — زر الحفظ
            ═════════════════════════════════════════════════ -->
            <Button Grid.Row="3" Height="50" Cursor="Hand"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="saveBtn" CornerRadius="12" Background="#1A2744">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                                  Color="#1A2744" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="18"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="حفظ الفاتورة"
                                           Foreground="White" FontSize="15"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="saveBtn" Property="Background" Value="#C0392B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="saveBtn" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             العمود الأيمن: إضافة أصناف
        ════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: إضافة صنف يدوي  -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <!-- 1: باركود + أكياس  -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════
                 إضافة صنف يدوي
            ═════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="White" BorderBrush="#E8EBF0" BorderThickness="1"
                    CornerRadius="14" Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#1A2744" Opacity="0.06"/>
                </Border.Effect>

                <StackPanel>
                    <!-- عنوان -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#EEF2FF" CornerRadius="6"
                                Padding="6,4" Margin="0,0,8,0">
                            <TextBlock Text="➕" FontSize="12"/>
                        </Border>
                        <TextBlock Text="إضافة صنف يدوي"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#1A2744" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- اسم الصنف -->
                    <TextBlock Text="الصنف / المنتج"
                               FontSize="10" Foreground="#8E8E93"
                               FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding BloodProductTypes}"
                              Text="{Binding NewLineName, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Style="{StaticResource FormComboBox}"
                              Margin="0,0,0,12"/>

                    <!-- الكمية + السعر -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الكمية"
                                       FontSize="10" Foreground="#8E8E93"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLineQty, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="سعر الوحدة (ج.م)"
                                       FontSize="10" Foreground="#8E8E93"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewLineUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- الإجمالي -->
                    <Border Background="#FFF8F0" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الإجمالي: " FontSize="12"
                                       Foreground="#566573" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NewLineTotal, StringFormat='{}{0:N2} ج.م'}"
                                       FontSize="15" FontWeight="Bold" Foreground="#C0392B"/>
                        </StackPanel>
                    </Border>

                    <!-- زر الإضافة -->
                    <Button Height="38" Cursor="Hand"
                            Command="{Binding AddManualLineCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ab" CornerRadius="9" Background="#C0392B">
                                    <TextBlock Text="➕  إضافة الصنف"
                                               Foreground="White" FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ab" Property="Background" Value="#922B21"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════
                 باركود + قائمة الأكياس المتاحة
            ═════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="White" BorderBrush="#E8EBF0" BorderThickness="1"
                    CornerRadius="14" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2"
                                      Color="#1A2744" Opacity="0.06"/>
                </Border.Effect>

                <DockPanel>
                    <!-- رأس -->
                    <Border DockPanel.Dock="Top"
                            Background="#F8F9FE" CornerRadius="14,14,0,0"
                            Padding="14,10">
                        <TextBlock Text="🔍 أكياس الدم المتاحة"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#1A2744"/>
                    </Border>

                    <!-- حقل الباركود -->
                    <Border DockPanel.Dock="Top"
                            x:Name="InvoiceScanBorder"
                            Margin="10,10,10,8"
                            CornerRadius="10"
                            BorderBrush="#E5E8EC"
                            BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="InvoiceScanIcon"
                                    Grid.Column="0"
                                    Background="#1A2744"
                                    CornerRadius="9,0,0,9"
                                    MouseLeftButtonDown="InvoiceScanIcon_Click"
                                    Cursor="Hand">
                                <Canvas Width="22" Height="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Rectangle Canvas.Left="1"  Width="2" Height="16" Fill="White"/>
                                    <Rectangle Canvas.Left="5"  Width="3" Height="16" Fill="White"/>
                                    <Rectangle Canvas.Left="10" Width="2" Height="16" Fill="White"/>
                                    <Rectangle Canvas.Left="14" Width="3" Height="16" Fill="White"/>
                                    <Rectangle Canvas.Left="19" Width="2" Height="16" Fill="White"/>
                                </Canvas>
                            </Border>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="TxtScanInvoice"
                                         Text="{Binding ScanBagNumber, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="10,0" FontSize="13"
                                         VerticalContentAlignment="Center" Height="36">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddLineByBarcodeCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="رقم الكيس + Enter"
                                           IsHitTestVisible="False"
                                           Foreground="#AAAAAA" FontSize="12"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtScanInvoice}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- قائمة الأكياس -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
                        <ListBox ItemsSource="{Binding AvailableBags}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.AddLineCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bagRow"
                                                        Background="White"
                                                        BorderBrush="#F0F2F5"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding BagNumber}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       Foreground="#1A2744"/>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="0,2,0,0">
                                                                <Border Background="#FFF0EE"
                                                                        CornerRadius="4"
                                                                        Padding="4,1" Margin="0,0,6,0">
                                                                    <TextBlock
                                                                        Text="{Binding BloodGroup,
                                                                               Converter={StaticResource EnumDisplay}}"
                                                                        Foreground="#C0392B"
                                                                        FontSize="10"
                                                                        FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock
                                                                    Text="{Binding ExpiryDate,
                                                                           StringFormat='ينتهي: d/M/yy'}"
                                                                    Foreground="#8E8E93"
                                                                    FontSize="10"
                                                                    VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Background="#F0FFF4"
                                                                CornerRadius="6"
                                                                Padding="8,3"
                                                                VerticalAlignment="Center">
                                                            <TextBlock
                                                                Text="{Binding SalePrice,
                                                                       StringFormat='{}{0:N0} ج'}"
                                                                Foreground="#1E8449"
                                                                FontWeight="Bold"
                                                                FontSize="12"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bagRow"
                                                                Property="Background" Value="#F0FFF4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
