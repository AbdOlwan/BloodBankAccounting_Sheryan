<Window x:Class="BloodBankAccounting.Views.EditInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:BloodBankAccounting.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="تعديل فاتورة"
        Width="820" Height="680"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F4F6F8">

    <Window.Resources>
        <conv:BoolToVisibilityConverter    x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:InverseBoolConverter         x:Key="InvBool"/>
        <conv:DecimalToStringConverter     x:Key="DecimalStr"/>

        <!-- Card border -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"     Value="White"/>
            <Setter Property="CornerRadius"   Value="12"/>
            <Setter Property="Padding"        Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                      Opacity="0.08" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="#566573"/>
            <Setter Property="Margin"       Value="0,0,0,4"/>
        </Style>

        <!-- Input -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="Padding"           Value="8,6"/>
            <Setter Property="BorderThickness"   Value="1.5"/>
            <Setter Property="BorderBrush"       Value="#E5E8EC"/>
            <Setter Property="Background"        Value="#FAFBFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"    Value="#C0392B"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="20,9"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#922B21"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground"      Value="#566573"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="18,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F4F6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small danger button (حذف صنف) -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Background"    Value="#FADBD8"/>
            <Setter Property="Foreground"    Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Width"         Value="30"/>
            <Setter Property="Height"        Value="30"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Info -->
            <RowDefinition Height="Auto"/>
            <!-- Fields Row -->
            <RowDefinition Height="Auto"/>
            <!-- Add Line Row -->
            <RowDefinition Height="*"/>
            <!-- Lines Grid -->
            <RowDefinition Height="Auto"/>
            <!-- Totals -->
            <RowDefinition Height="Auto"/>
            <!-- Error/Success -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Header ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1A2744">
                        <Run Text="✏️ تعديل فاتورة "/>
                        <Run Text="{Binding InvoiceNumber}" Foreground="#C0392B"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#566573">
                        <Run Text="العميل: "/>
                        <Run Text="{Binding CustomerName}" FontWeight="SemiBold" Foreground="#1A2744"/>
                        <Run Text="    |    نوع الدفع: "/>
                        <Run Text="{Binding PaymentTypeDisplay}" FontWeight="SemiBold" Foreground="#1A2744"/>
                    </TextBlock>
                </StackPanel>

                <!-- Busy Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="⏳ جارٍ المعالجة..." FontSize="13" Foreground="#C0392B"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 1: الحقول القابلة للتعديل ═══════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- التاريخ -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="تاريخ الفاتورة"/>
                    <DatePicker SelectedDate="{Binding Date}"
                         FontSize="14" Padding="4,4"
                         BorderBrush="#E5E8EC" BorderThickness="1.5"
                         Background="#FAFBFC"
                         DisplayDateEnd="{x:Static sys:DateTime.Today}"/>
                </StackPanel>

                <!-- الخصم -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="الخصم (جنيه)"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding DiscountAmount, Converter={StaticResource DecimalStr},
                                    UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- الملاحظات -->
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Lbl}" Text="ملاحظات"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="300"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 2: إضافة صنف يدوي جديد ═══════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- اسم الصنف -->
                <!-- اسم الصنف — مرتبط بالمخزون -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Lbl}" Text="اختر صنفاً من المخزون"/>
                    <ComboBox ItemsSource="{Binding AvailableStocks}"
              SelectedItem="{Binding SelectedStock}"
              
              IsEditable="False"
              FontSize="14" Padding="6,5"
              BorderBrush="#E5E8EC" BorderThickness="1.5"
              Background="#FAFBFC">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                    <TextBlock Text=" (" FontSize="12" Foreground="#85929E"/>
                                    <TextBlock Text="{Binding AvailableQty}" FontSize="12" Foreground="#1E8449" FontWeight="SemiBold"/>
                                    <TextBlock Text=" متاح)" FontSize="12" Foreground="#85929E"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- الكمية -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Lbl}" Text="الكمية"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding NewLineQty, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- سعر الوحدة -->
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Lbl}" Text="سعر الوحدة"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding NewLineUnitPrice, Converter={StaticResource DecimalStr},
                                    UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- الإجمالي (للعرض) -->
                <StackPanel Grid.Column="6">
                    <TextBlock Style="{StaticResource Lbl}" Text="الإجمالي"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#1A2744"
                               VerticalAlignment="Center" Margin="0,8,0,0"
                               Text="{Binding NewLineTotal, StringFormat='{}{0:N2}'}"/>
                </StackPanel>

                <!-- زر الإضافة -->
                <Button Grid.Column="8"
                        Content="+ إضافة صنف"
                        Style="{StaticResource BtnGhost}"
                        VerticalAlignment="Bottom"
                        Command="{Binding AddManualLineCommand}"/>
            </Grid>
        </Border>

        <!-- ═══ Row 3: جدول الأصناف ═══════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="أصناف الفاتورة"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#566573" Margin="0,0,0,8"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F3F4"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          FontSize="13"
                          MaxHeight="200"
                          HeadersVisibility="Column">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"   Value="#F4F6F8"/>
                            <Setter Property="Foreground"   Value="#566573"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="Padding"      Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- اسم الصنف -->
                        <DataGridTemplateColumn Header="اسم الصنف" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="13" Padding="6,4"
                                             IsEnabled="{Binding IsEditable}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الكمية -->
                        <DataGridTemplateColumn Header="الكمية" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="13" Padding="6,4"
                                             IsEnabled="{Binding IsEditable}"
                                             TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- سعر الوحدة -->
                        <DataGridTemplateColumn Header="سعر الوحدة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, Converter={StaticResource DecimalStr},
                                                    UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="13" Padding="6,4"
                                             IsEnabled="{Binding IsEditable}"
                                             TextAlignment="Left"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الإجمالي -->
                        <DataGridTextColumn Header="الإجمالي" Width="110"
                                            Binding="{Binding Total, StringFormat='{}{0:N2}'}"
                                            IsReadOnly="True"/>

                        <!-- نوع الصنف -->
                        <DataGridTemplateColumn Header="النوع" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EBF5FB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                        <Setter Property="Background" Value="#EAFAF1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="🩸 كيس"/>
                                                    <Setter Property="Foreground" Value="#1A5276"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManual}" Value="True">
                                                            <Setter Property="Text"       Value="✏️ يدوي"/>
                                                            <Setter Property="Foreground" Value="#1E8449"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- زر حذف -->
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BtnDanger}"
                                            Content="✕"
                                            ToolTip="حذف هذا الصنف"
                                            IsEnabled="{Binding IsEditable}"
                                            Command="{Binding DataContext.RemoveLineCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ═══ Row 4: الإجماليات ══════════════════════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="إجمالي الأصناف:"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding SubTotal, StringFormat='{}{0:N2} جنيه'}"
                           FontSize="14" FontWeight="SemiBold" Foreground="#1A2744"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource Lbl}" Text="الخصم:"/>
                <TextBlock Grid.Row="0" Grid.Column="4"
                           Text="{Binding DiscountAmount, StringFormat='{}{0:N2} جنيه'}"
                           FontSize="14" Foreground="#C0392B"/>

                <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Background="#E5E8EC"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="الإجمالي الجديد:" FontSize="14" FontWeight="Bold" Foreground="#1A2744"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding TotalAmount, StringFormat='{}{0:N2} جنيه'}"
                           FontSize="16" FontWeight="Bold" Foreground="#C0392B"/>
            </Grid>
        </Border>

        <!-- Row 5: فارغ — الرسائل تظهر عبر MessageBox من ViewModelBase -->

        <!-- ═══ Row 6: أزرار الحفظ / الإلغاء ════════════════════════════ -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- تحذير أصناف الكيس -->
            <TextBlock Grid.Column="0"
                       Text="⚠️ الأصناف المرتبطة بأكياس الدم (🩸) غير قابلة للتعديل أو الحذف."
                       FontSize="12" Foreground="#85929E"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="💾 حفظ التعديلات"
                    Style="{StaticResource BtnPrimary}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"
                    Command="{Binding SaveCommand}"
                    x:Name="BtnSave"/>

            <Button Grid.Column="3"
                    Content="إلغاء"
                    Style="{StaticResource BtnGhost}"
                    x:Name="BtnCancel"/>
        </Grid>
    </Grid>
</Window>
