<UserControl x:Class="BloodBankAccounting.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,32">
        <StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 زر القفل / فتح البيانات المالية
            ═══════════════════════════════════════════════════════════════ -->
            <Border Margin="0,0,0,24" HorizontalAlignment="Right">
                <Button Command="{Binding ToggleFinancialLockCommand}"
                        Cursor="Hand" BorderThickness="0" Padding="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="lockBorder" CornerRadius="10" Padding="14,9"
                                    Background="#1A2744">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LockIcon}" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding LockButtonText}"
                                               Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="lockBorder" Property="Background" Value="#2C3E6B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>


            <!-- ══════════════════════════════════════════════════════════
                 القسم الأول: إحصائيات اليوم
            ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#C0392B" BorderThickness="0,0,4,0"
                    Padding="0,3,14,3" Margin="0,0,0,14">
                <TextBlock Text="📅  إحصائيات اليوم"
                           FontSize="15" FontWeight="Bold" Foreground="#1A2744"/>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,28">

                <!-- ── مبيعات اليوم ── -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#C0392B" Margin="0,0,10,0"/>
                            <TextBlock Text="مبيعات اليوم" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="📈" FontSize="28" Margin="0,0,0,8"/>
                        <!-- مقفول -->
                        <TextBlock Text="•  •  •  •  •" FontSize="20" FontWeight="Bold"
                                   Foreground="#DDD" 
                                   Visibility="{Binding IsFinancialUnlocked,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <!-- مفتوح -->
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#C0392B">
                                <Run Text="{Binding TodaySales, StringFormat='{}{0:N0}'}"/>
                                <Run Text=" ج.م" FontSize="13" Foreground="#AAA"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="إجمالي الفواتير الصادرة"
                                   FontSize="11" Foreground="#AAA" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── إيرادات اليوم ── -->
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#27AE60" Margin="0,0,10,0"/>
                            <TextBlock Text="إيرادات اليوم" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="💰" FontSize="28" Margin="0,0,0,8"/>
                        <TextBlock Text="•  •  •  •  •" FontSize="20" FontWeight="Bold" Foreground="#DDD"
                                   Visibility="{Binding IsFinancialUnlocked,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#27AE60">
                                <Run Text="{Binding TodayRevenue, StringFormat='{}{0:N0}'}"/>
                                <Run Text=" ج.م" FontSize="13" Foreground="#AAA"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="الفلوس المحصّلة فعلاً"
                                   FontSize="11" Foreground="#AAA" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── فواتير اليوم ── -->
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#2471A3" Margin="0,0,10,0"/>
                            <TextBlock Text="فواتير اليوم" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="🧾" FontSize="28" Margin="0,0,0,8"/>
                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="#2471A3">
                            <Run Text="{Binding TodayInvoicesCount}"/>
                            <Run Text=" فاتورة" FontSize="14" Foreground="#AAA"/>
                        </TextBlock>
                        <!-- تفاصيل نوع الفاتورة -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="#EAF5EA" CornerRadius="5" Padding="7,4" Margin="0,0,6,0">
                                <TextBlock FontSize="11" Foreground="#27AE60">
                                    <Run Text="✓ نقدي "/>
                                    <Run Text="{Binding TodayCashInvoices}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#FEF5E7" CornerRadius="5" Padding="7,4">
                                <TextBlock FontSize="11" Foreground="#D35400">
                                    <Run Text="⏱ آجل "/>
                                    <Run Text="{Binding TodayCreditInvoices}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── نسبة التحصيل اليوم ── -->
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#8E44AD" Margin="0,0,10,0"/>
                            <TextBlock Text="نسبة التحصيل" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="📊" FontSize="28" Margin="0,0,0,8"/>
                        <TextBlock Text="•  •  •  •  •" FontSize="20" FontWeight="Bold" Foreground="#DDD"
                                   Visibility="{Binding IsFinancialUnlocked,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#8E44AD">
                                <Run Text="{Binding CollectionRateToday, StringFormat='{}{0:N1}'}"/>
                                <Run Text=" %" FontSize="16"/>
                            </TextBlock>
                            <!-- شريط التقدم -->
                            <Border Height="8" Background="#EDE0FF" CornerRadius="4" Margin="0,10,0,0">
                                <Border HorizontalAlignment="Right" Height="8"
                                        Width="{Binding CollectionRateTodayWidth}"
                                        MaxWidth="180"
                                        Background="#8E44AD" CornerRadius="4"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="نسبة ما تم تحصيله من المبيعات"
                                   FontSize="11" Foreground="#AAA" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>


            <!-- ══════════════════════════════════════════════════════════
                 القسم الثاني: إحصائيات الشهر
            ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#2471A3" BorderThickness="0,0,4,0"
                    Padding="0,3,14,3" Margin="0,0,0,14">
                <TextBlock Text="📆  إحصائيات الشهر الحالي"
                           FontSize="15" FontWeight="Bold" Foreground="#1A2744"/>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,28">

                <!-- ── مبيعات الشهر ── -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#C0392B" Margin="0,0,10,0"/>
                            <TextBlock Text="مبيعات الشهر" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="📈" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="•  •  •  •  •" FontSize="20" FontWeight="Bold" Foreground="#DDD"
                                   Visibility="{Binding IsFinancialUnlocked,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#C0392B">
                                <Run Text="{Binding MonthSales, StringFormat='{}{0:N0}'}"/>
                                <Run Text=" ج.م" FontSize="12" Foreground="#AAA"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="إجمالي مبيعات الشهر"
                                   FontSize="11" Foreground="#AAA" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── إيرادات الشهر ── -->
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#27AE60" Margin="0,0,10,0"/>
                            <TextBlock Text="إيرادات الشهر" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="💰" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="•  •  •  •  •" FontSize="20" FontWeight="Bold" Foreground="#DDD"
                                   Visibility="{Binding IsFinancialUnlocked,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#27AE60">
                                <Run Text="{Binding MonthRevenue, StringFormat='{}{0:N0}'}"/>
                                <Run Text=" ج.م" FontSize="12" Foreground="#AAA"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="الفلوس المحصّلة هذا الشهر"
                                   FontSize="11" Foreground="#AAA" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── فواتير الشهر ── -->
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#2471A3" Margin="0,0,10,0"/>
                            <TextBlock Text="فواتير الشهر" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="🧾" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#2471A3">
                            <Run Text="{Binding MonthInvoicesCount}"/>
                            <Run Text=" فاتورة" FontSize="13" Foreground="#AAA"/>
                        </TextBlock>
                        <!-- شريط نسبة التحصيل الشهري هنا للمرجع السريع -->
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Margin="0,8,0,2" FontSize="11" Foreground="#AAA">
                                <Run Text="نسبة التحصيل: "/>
                                <Run Text="{Binding CollectionRateMonth, StringFormat='{}{0:N1}%'}"
                                     Foreground="#8E44AD" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Border Height="5" Background="#EDE0FF" CornerRadius="3">
                                <Border HorizontalAlignment="Right" Height="5"
                                        Width="{Binding CollectionRateMonthWidth}"
                                        MaxWidth="180"
                                        Background="#8E44AD" CornerRadius="3"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── متوسط يومي ── -->
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" CornerRadius="2" Background="#D35400" Margin="0,0,10,0"/>
                            <TextBlock Text="متوسط يومي" FontSize="12" Foreground="#777"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="📉" FontSize="24" Margin="0,0,0,8"/>
                        <TextBlock Text="•  •  •  •  •" FontSize="20" FontWeight="Bold" Foreground="#DDD"
                                   Visibility="{Binding IsFinancialUnlocked,
                                                Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#D35400">
                                <Run Text="{Binding AverageDailySales, StringFormat='{}{0:N0}'}"/>
                                <Run Text=" ج.م" FontSize="12" Foreground="#AAA"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="متوسط مبيعاتك في اليوم"
                                   FontSize="11" Foreground="#AAA" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>


            <!-- ══════════════════════════════════════════════════════════
                 القسم الثالث: الرسوم البيانية
            ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#1E8449" BorderThickness="0,0,4,0"
                    Padding="0,3,14,3" Margin="0,0,0,14">
                <TextBlock Text="📊  الرسوم البيانية"
                           FontSize="15" FontWeight="Bold" Foreground="#1A2744"/>
            </Border>

            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- ── رسم مبيعات آخر 7 أيام ── -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>

                        <!-- ─── عنوان + مفتاح الألوان — عمودان منفصلان لمنع التداخل ─── -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- العنوان — العمود الأيمن (RTL) -->
                            <TextBlock Grid.Column="0"
                                       Text="المبيعات والإيرادات — آخر 7 أيام"
                                       FontSize="13" FontWeight="Bold" Foreground="#1A2744"
                                       VerticalAlignment="Center"/>

                            <!-- مفتاح الألوان — العمود الأيسر -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                <Border Width="10" Height="10" Background="#C0392B"
                                        CornerRadius="2" Margin="0,0,5,0"/>
                                <TextBlock Text="مبيعات" FontSize="11" Foreground="#666"
                                           Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <Border Width="10" Height="10" Background="#27AE60"
                                        CornerRadius="2" Margin="0,0,5,0"/>
                                <TextBlock Text="إيرادات" FontSize="11" Foreground="#666"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- ─── حالة القفل المالي ─── -->
                        <Border Height="136" VerticalAlignment="Center"
                                Visibility="{Binding IsFinancialUnlocked,
                                             Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🔒" FontSize="28" TextAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="•  •  •  •  •  •  •"
                                           FontSize="22" FontWeight="Bold" Foreground="#DDD"
                                           TextAlignment="Center"/>
                                <TextBlock Text="افتح البيانات المالية لعرض الرسم البياني"
                                           FontSize="11" Foreground="#BBB"
                                           TextAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ─── الأعمدة البيانية — تظهر فقط عند فتح القفل ─── -->
                        <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- FlowDirection="LeftToRight" يضمن الترتيب الزمني الصحيح -->
                            <ItemsControl ItemsSource="{Binding WeeklySales}"
                                          FlowDirection="LeftToRight">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="62" Margin="3,0" HorizontalAlignment="Center">

                                            <!-- الأعمدة: مبيعات + إيرادات جنباً لجنب -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                                <!-- عمود المبيعات -->
                                                <StackPanel Width="20" Margin="0,0,4,0">
                                                    <Border Height="{Binding SalesSpacerHeight}"
                                                            Background="Transparent"/>
                                                    <Border Height="{Binding SalesBarHeight}"
                                                            CornerRadius="3,3,0,0">
                                                        <Border.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock>
                                                                    <Run Text="مبيعات: "/>
                                                                    <Run Text="{Binding Sales, StringFormat='{}{0:N0}'}"/>
                                                                    <Run Text=" ج.م"/>
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#D5A09A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Background" Value="#C0392B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SalesBarHeight}" Value="0">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </StackPanel>

                                                <!-- عمود الإيرادات -->
                                                <StackPanel Width="20">
                                                    <Border Height="{Binding RevenueSpacerHeight}"
                                                            Background="Transparent"/>
                                                    <Border Height="{Binding RevenueBarHeight}"
                                                            CornerRadius="3,3,0,0">
                                                        <Border.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock>
                                                                    <Run Text="إيرادات: "/>
                                                                    <Run Text="{Binding Revenue, StringFormat='{}{0:N0}'}"/>
                                                                    <Run Text=" ج.م"/>
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#A0D4B4"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Background" Value="#27AE60"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RevenueBarHeight}" Value="0">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </StackPanel>

                                            </StackPanel>

                                            <!-- خط فاصل -->
                                            <Border Height="1" Background="#EBEBEB" Margin="0,0,0,4"/>

                                            <!-- اسم اليوم -->
                                            <TextBlock Text="{Binding Label}" TextAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                                            <!-- التاريخ -->
                                            <TextBlock Text="{Binding DateLabel}" TextAlignment="Center"
                                                       FontSize="10" Foreground="#BBB" Margin="0,2,0,0"/>

                                            <!-- "اليوم" badge -->
                                            <Border CornerRadius="4" Padding="4,2" Margin="4,3,4,0"
                                                    HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Background" Value="#1A2744"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="اليوم" FontSize="9" Foreground="White"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- حالة فارغة -->
                            <TextBlock Text="لا توجد بيانات للأسبوع الماضي"
                                       FontSize="12" Foreground="#BBB" TextAlignment="Center"
                                       Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WeeklySales.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>
                        <!-- ─── نهاية محتوى القفل ─── -->

                    </StackPanel>
                </Border>

                <!-- ── توزيع فصائل الدم المتاحة ── -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🩸  فصائل الدم المتاحة"
                                   FontSize="13" FontWeight="Bold" Foreground="#1A2744"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding BloodGroupStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- اسم الفصيلة -->
                                        <Border Grid.Column="0" Background="{Binding Brush}"
                                                CornerRadius="5" Padding="4,4"
                                                HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding GroupName}"
                                                       Foreground="White" FontSize="11"
                                                       FontWeight="Bold" TextAlignment="Center"/>
                                        </Border>

                                        <!-- شريط التوزيع -->
                                        <Border Grid.Column="1" Height="16" Background="#F2F2F2"
                                                CornerRadius="4" Margin="8,0"
                                                VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Right" Height="16"
                                                    Width="{Binding BarWidth}" MaxWidth="200"
                                                    Background="{Binding Brush}" CornerRadius="4"/>
                                        </Border>

                                        <!-- العدد -->
                                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                   FontSize="13" FontWeight="Bold" Foreground="#333"
                                                   VerticalAlignment="Center" TextAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- حالة فارغة -->
                        <Border Background="#FFF5F5" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BloodGroupStats.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="⚠ لا توجد أكياس دم متاحة حالياً"
                                       FontSize="12" Foreground="#C0392B" TextAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>


            <!-- ══════════════════════════════════════════════════════════
                 القسم الرابع: المؤشرات المالية والمخزون
            ═══════════════════════════════════════════════════════════════ -->
            <Border BorderBrush="#D35400" BorderThickness="0,0,4,0"
                    Padding="0,3,14,3" Margin="0,0,0,14">
                <TextBlock Text="⚡  المؤشرات والتنبيهات"
                           FontSize="15" FontWeight="Bold" Foreground="#1A2744"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- ── المؤشرات المالية ── -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="💼  الخزينة والديون"
                                   FontSize="13" FontWeight="Bold" Foreground="#1A2744"
                                   Margin="0,0,0,14"/>

                        <!-- رصيد الخزينة + إجمالي الديون جنباً لجنب -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- رصيد الخزينة -->
                            <Border Grid.Column="0" Background="#F0FFF4" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="🏦" FontSize="22" Margin="0,0,0,6"/>
                                    <TextBlock Text="رصيد الخزينة" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="•  •  •  •  •" FontSize="18" FontWeight="Bold"
                                               Foreground="#DDD" Margin="0,4,0,0"
                                               Visibility="{Binding IsFinancialUnlocked,
                                                            Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,4,0,0">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#27AE60">
                                            <Run Text="{Binding SafeBalance, StringFormat='{}{0:N0}'}"/>
                                            <Run Text=" ج.م" FontSize="12" Foreground="#AAA"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- إجمالي الديون -->
                            <Border Grid.Column="2" Background="#FFF8F0" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="📉" FontSize="22" Margin="0,0,0,6"/>
                                    <TextBlock Text="إجمالي الديون" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="•  •  •  •  •" FontSize="18" FontWeight="Bold"
                                               Foreground="#DDD" Margin="0,4,0,0"
                                               Visibility="{Binding IsFinancialUnlocked,
                                                            Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <StackPanel Visibility="{Binding IsFinancialUnlocked,
                                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,4,0,0">
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#D35400">
                                            <Run Text="{Binding TotalDebt, StringFormat='{}{0:N0}'}"/>
                                            <Run Text=" ج.م" FontSize="12" Foreground="#AAA"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- أكبر مدين — يظهر فقط لو القفل مفتوح -->
                        <Border Background="#FEFAF0" CornerRadius="10" Padding="16,12"
                                Visibility="{Binding IsFinancialUnlocked,
                                             Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="⚠  أكبر مدين" FontSize="11"
                                               Foreground="#D35400" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TopDebtorName}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#1A2744" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#E74C3C">
                                        <Run Text="{Binding TopDebtorBalance, StringFormat='{}{0:N0}'}"/>
                                        <Run Text=" ج.م" FontSize="12" Foreground="#AAA"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ── المخزون والتنبيهات ── -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🩸  المخزون والتنبيهات"
                                   FontSize="13" FontWeight="Bold" Foreground="#1A2744"
                                   Margin="0,0,0,14"/>

                        <!-- أكياس متاحة -->
                        <Border Background="#FFF5F5" CornerRadius="10" Padding="16,14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🩸  أكياس متاحة" FontSize="12" Foreground="#666"/>
                                    <TextBlock Text="جاهزة للصرف والبيع"
                                               FontSize="11" Foreground="#BBB" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" FontSize="32" FontWeight="Bold"
                                           Foreground="#C0392B" VerticalAlignment="Center">
                                    <Run Text="{Binding AvailableBags}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- تحذير الأكياس المنتهية قريباً -->
                        <Border CornerRadius="10" Padding="16,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F5FFF5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExpiringBags}" Value="True">
                                            <Setter Property="Background" Value="#FFF8E1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- النص: يتغير حسب وجود تحذير -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Foreground="#666">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓  لا تنبيهات انتهاء صلاحية"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExpiringBags}" Value="True">
                                                        <Setter Property="Text" Value="⚠  أكياس ستنتهي قريباً"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="خلال الأسبوع القادم"
                                               FontSize="11" Foreground="#BBB" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- العدد: أخضر لو صفر، برتقالي لو فيه تحذير -->
                                <TextBlock Grid.Column="1" FontSize="32" FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding ExpiringBags}"/>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasExpiringBags}" Value="True">
                                                    <Setter Property="Foreground" Value="#D35400"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
