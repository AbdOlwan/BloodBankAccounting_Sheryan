<!-- 
    SecretAdminPanel.xaml
    ملاحظة: الـ Dialog ده مش مربوط بأي قائمة أو زرار ظاهر.
    يتفتح فقط من خلال Key Combo سري في MainWindow.
-->
<Window x:Class="BloodBankAccounting.Views.SecretAdminPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ إدارة النظام"
        Width="420" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1E1E2E"
        Foreground="White"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#C0392B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style x:Key="SafeBtn" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="🔒 لوحة المطوّر — سرية"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#E74C3C"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <TextBlock Text="هذه الأدوات للمطوّر فقط. تأكد قبل أي عملية."
                   FontSize="12" Foreground="#AAA"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Backup -->
        <Button x:Name="BtnBackup"
                Content="💾  نسخ احتياطي لقاعدة البيانات"
                Style="{StaticResource SafeBtn}"
                Click="BtnBackup_Click"/>

        <!-- Clear Data -->
        <Button x:Name="BtnClear"
                Content="🗑  مسح كل البيانات (مع الحفاظ على الهيكل)"
                Style="{StaticResource DangerBtn}"
                Click="BtnClear_Click"/>

        <!-- Drop DB -->
        <Button x:Name="BtnDrop"
                Content="💣  حذف قاعدة البيانات بالكامل"
                Style="{StaticResource DangerBtn}"
                Background="#7B241C"
                Click="BtnDrop_Click"/>

        <!-- Status -->
        <TextBlock x:Name="TxtStatus"
                   FontSize="12" Foreground="#2ECC71"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Window>
