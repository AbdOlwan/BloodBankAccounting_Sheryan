<Window x:Class="BloodBankAccounting.Views.TrialView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شريان — تفعيل البرنامج"
        Height="700" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F6F8">

    <Grid>
        <Border Margin="28" Background="White" CornerRadius="16"
                BorderBrush="#E5E8EC" BorderThickness="1">
            <StackPanel Margin="32,28">

                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#C0392B" CornerRadius="14"
                            Width="60" Height="60" HorizontalAlignment="Center">
                        <TextBlock Text="&#x1F9B8;" FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="شريان" FontSize="22" FontWeight="Bold"
                               Foreground="#1A2744" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Trial banner -->
                <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFF3CD"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="Background" Value="#FADBD8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#856404"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter Property="Foreground" Value="#922B21"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run FontWeight="Bold">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Text" Value="&#x23F3;  نسخة تجريبية"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                            <Setter Property="Text" Value="&#x26D4;  انتهت فترة التجربة"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                        <LineBreak/>
                        <Run>
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Text"
                                            Value="{Binding DaysRemaining, Mode=OneWay, StringFormat='متبقي {0} يوم من فترة التجربة المجانية'}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                            <Setter Property="Text"
                                                    Value="يجب تفعيل البرنامج للاستمرار في الاستخدام"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                </Border>

                <!-- Machine ID -->
                <TextBlock Text="معرّف جهازك" FontSize="12" FontWeight="SemiBold"
                           Foreground="#566573" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F4F6F8" CornerRadius="8,0,0,8"
                            Padding="12,10" BorderBrush="#E5E8EC" BorderThickness="1,1,0,1">
                        <TextBlock Text="{Binding MachineId}"
                                   FontFamily="Consolas" FontSize="14"
                                   FontWeight="Bold" Foreground="#1A2744"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- زر النسخ — CopyButtonText مربوط بالـ ViewModel -->
                    <Button Grid.Column="1"
                            Command="{Binding CopyMachineIdCommand}"
                            BorderThickness="0"
                            Width="72"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <!-- FIX: الـ Border يحتوي على TextBlock فقط -->
                                <Border x:Name="copyBorder"
                                        CornerRadius="0,8,8,0"
                                        Background="#1A2744">
                                    <TextBlock Text="{Binding CopyButtonText}"
                                               Foreground="White" FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- FIX: ControlTemplate.Triggers خارج الـ Border مباشرة -->
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="copyBorder" Property="Background" Value="#2C3E6B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Activation key input -->
                <TextBlock Text="كود التفعيل" FontSize="12" FontWeight="SemiBold"
                           Foreground="#566573" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ActivationKey, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                         Padding="12,0"
                         Height="44"
                         BorderBrush="#E5E8EC" BorderThickness="1"
                         Background="White" TextAlignment="Center"
                         Margin="0,0,0,8">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ActivateCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Status message -->
                <TextBlock Text="{Binding TrialStatus}"
                           FontSize="12" Margin="0,0,0,12"
                           MinHeight="16"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#27AE60"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Activate button -->
                <Button Content="&#x1F513;  تفعيل البرنامج"
                        Command="{Binding ActivateCommand}"
                        Background="#C0392B" Foreground="White"
                        BorderThickness="0" Height="46"
                        FontSize="14" FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#922B21"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- زر التخطي — مخفي لو الفترة انتهت -->
                <Button Margin="0,10,0,0"
                        Height="42"
                        Background="#F4F6F8"
                        BorderBrush="#D5D8DC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Command="{Binding ContinueTrialCommand}"
                        Visibility="{Binding IsExpired, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- FIX: الـ Border يحتوي على StackPanel فقط -->
                            <Border x:Name="skipBorder" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="تخطي" FontWeight="SemiBold"
                                               Foreground="#3D5166"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  ←  متابعة بالنسخة التجريبية"
                                               Foreground="#8A9BB0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- FIX: ControlTemplate.Triggers خارج الـ Border مباشرة -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="skipBorder" Property="Background" Value="#E8EAED"/>
                                    <Setter TargetName="skipBorder" Property="BorderBrush" Value="#B2B6BB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="skipBorder" Property="Background" Value="#DDE0E4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
